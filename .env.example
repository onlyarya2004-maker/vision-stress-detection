# Copy to .env (git-ignored) or set these in Azure / your shell. Never commit real values.
# Only the PUBLIC key goes here. The service_role / secret key must never be in the app.

# Hosted mode (login + Supabase database):
STRESS_STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-OR-PUBLISHABLE-KEY

# 'browser' = the user's browser owns the camera (required when hosted);
# 'local'   = cv2.VideoCapture on the machine running Streamlit (development).
STRESS_CAPTURE_MODE=browser

# Local single-user development instead (SQLite, no login):
#   STRESS_STORAGE_BACKEND=sqlite
# STRESS_DB_PATH=../data/sessions.db     # test runs point this at a scratch file

# Optional hosted hardening:
# STRESS_SIGNUP_CODE=choose-an-invite-code   # new accounts must enter this (stops strangers signing up)
# STRESS_MAX_SESSIONS=6                      # refuse new logins beyond this many at once
# STRESS_LOCAL_FACE_BOX=0                    # skip the in-browser face-box library (CDN download)

# Debug aids (leave unset in production):
# STRESS_PROFILE=1                               # print per-batch server timings
# STRESS_TEST_FRAMES_URL=http://localhost:8765   # fake camera for end-to-end tests
