# Copy to .env (git-ignored) or set these in Azure / your shell. Never commit real values.
# Only the PUBLIC key goes here. The service_role / secret key must never be in the app
# (auth.validate_public_key refuses it and the app will not start).

# --- Hosted mode: login + Supabase database ---
STRESS_STORAGE_BACKEND=supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase renamed this key from "anon" to "publishable". Either name works;
# SUPABASE_PUBLISHABLE_KEY wins if both are set. Copy it from
# Supabase dashboard -> Project Settings -> API Keys.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLIC_KEY
# SUPABASE_ANON_KEY=...        # legacy name, still accepted

# 'browser' = the user's browser owns the camera (required when hosted);
# 'local'   = cv2.VideoCapture on the machine running Streamlit (development).
STRESS_CAPTURE_MODE=browser

# --- Local single-user development instead (SQLite, no login) ---
#   STRESS_STORAGE_BACKEND=sqlite
# STRESS_DB_PATH=../data/sessions.db     # test runs point this at a scratch file

# --- Sign-in (hosted mode) ---
# Email + password only. Registration is open (no invite code); whether new
# accounts must confirm their email is a Supabase dashboard setting, and the
# confirmation link lands on Supabase's "Site URL" - set that to the app's address.

# --- Optional hosted hardening ---
# STRESS_MAX_SESSIONS=6                      # refuse new logins beyond this many at once
# STRESS_LOCAL_FACE_BOX=0                    # skip the in-browser face-box library (CDN download)

# --- Debug aids (leave unset in production) ---
# STRESS_PROFILE=1                               # print per-batch server timings
# STRESS_TEST_FRAMES_URL=http://localhost:8765   # fake camera for end-to-end tests

# ---------------------------------------------------------------------------
# RUNNING LOCALLY IN HOSTED MODE
# ---------------------------------------------------------------------------
# Easiest: put the same names in code/.streamlit/secrets.toml (git-ignored).
# Streamlit copies that file into the process environment, and app.py's
# apply_secret_overrides() picks up STRESS_STORAGE_BACKEND / STRESS_CAPTURE_MODE
# from it too (config.py itself reads os.environ only, so that the CLI tools
# can import it without pulling in Streamlit):
#
#   # code/.streamlit/secrets.toml
#   SUPABASE_URL = "https://YOUR-PROJECT.supabase.co"
#   SUPABASE_PUBLISHABLE_KEY = "sb_publishable_YOUR_PUBLIC_KEY"
#   STRESS_STORAGE_BACKEND = "supabase"
