# Keep the build context (and therefore the image) to code + models only.
# In particular NOTHING personal may enter an image: the team recordings,
# evaluation exports, local databases and raw research datasets stay out.
.git
.gitattributes
.claude
.vscode
.venv*
# Each of these needs BOTH forms. Docker's "**/" matches zero or more leading
# segments, but az acr build compiles "**/x" to ^.*/x$, which requires at least
# one - so the repo-root copy would otherwise be packed.
**/__pycache__
__pycache__
**/.pytest_cache
.pytest_cache
**/*.pyc
*.pyc

# NO TRAILING SLASHES on these directory rules. Docker treats "datasets" and
# "datasets/" alike, but `az acr build` compiles "datasets/" to the regex
# ^datasets/$ - which matches neither "datasets" nor "datasets/anything", so the
# rule becomes silently inert and the whole directory gets packed and uploaded.
# Without the slash it compiles to ^datasets$, matches the directory entry, and
# the subtree is pruned. (Verified against azure-cli 2.88.0's own packer.)
datasets
evaluation_data
data
BACKUP_DEMO_FINAL
supabase
deploy
scripts
*.md
*.txt
!requirements.txt
*.log
*.db
*.db-*

# code/ is copied, but not the things the running app never imports
code/tests
code/_archive
code/README.md

# Credentials. code/.streamlit/ must stay (config.toml carries the theme), but
# secrets.toml holds the live Supabase key and must NEVER enter an image layer -
# anyone who can pull the image could read it. On Azure the same names arrive as
# Container Apps secrets at runtime instead.
**/.streamlit/secrets.toml
.env
.env.*
!.env.example
*.pem
